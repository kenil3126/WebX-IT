# Copy this file to ".env" (same folder) and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# EmailJS keys are NOT set here — open src/lib/emailClient.js and paste them
# directly at the top of that file (no .env, no rebuild needed for those).
